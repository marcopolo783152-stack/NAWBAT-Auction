# Public application URL
APP_URL="http://localhost:3000"

# PostgreSQL (Neon, Supabase Postgres, Vercel Postgres, or standard PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nawbat?sslmode=require"

# Admin authentication
# Generate a password hash with:
# npm run hash:password -- "your-strong-password"
ADMIN_EMAIL="admin@nawbat.af"
ADMIN_PASSWORD_HASH=""
JWT_SECRET="replace-with-at-least-32-random-characters"

# HesabPay
# Keep sandbox enabled until merchant credentials and webhook verification are confirmed.
HESABPAY_SANDBOX="true"
HESABPAY_BASE_URL=""
HESABPAY_API_KEY=""
HESABPAY_WEBHOOK_SECRET=""
HESABPAY_MERCHANT_ID=""

# Optional AI features only. Never expose this key to the browser.
GEMINI_API_KEY=""
